#!/bin/bash
# Exercise 3b -- right-size this job.
#
# The job aligns all simulated samples and, when it finishes, writes
# right_size.done. As submitted it is too small: it will be killed before it
# finishes. Your task:
#
#   1. Use your measurements from exercise 3a (timings.tsv) to pick resources.
#   2. Fill in the memory (___ gb) and set a walltime that gives the job a
#      comfortable margin: roughly 2x what you expect, NOT "24 hours just in case".
#   3. Choose ncpus (the script uses whatever it is given).
#   4. qsub exercise_03b_right_size.pbs, then ./check_03b.sh
#
# The checker also complains if you request an unreasonable amount
# (more than 10 minutes or more than 8 GB): a good citizen asks for what the job needs.

#PBS -N ex03b
#PBS -l select=1:ncpus=1:mem=___gb
#PBS -l walltime=00:00:10
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1
source ../lib/edu.sh || exit 1
edu_banner
edu_preflight || exit 1
set -o pipefail

THREADS="$(edu_threads)"
OUT="$WORKDIR/03_resources_threads"
RUN="$OUT/ex03b_run"
mkdir -p "$RUN"
rm -f "$OUT/right_size.done"

START=$(date +%s)
while IFS=$'\t' read -r id r1 r2; do
    echo "[$(date +%T)] aligning $id with $THREADS thread(s)"
    edu_exec minimap2 -t "$THREADS" -ax sr "$DATA_DIR/ref/genome.fasta" "$r1" "$r2" 2> "$RUN/$id.log" \
        | edu_exec samtools sort -@ "$((THREADS - 1))" -m 256M -T "$RUN/$id.tmp" -o "$RUN/$id.bam" - \
        || exit 1
done < "$DATA_DIR/samples/samples.tsv"

echo "threads=$THREADS seconds=$(( $(date +%s) - START ))" > "$OUT/right_size.done"
rm -rf "$RUN"
echo "Finished."
