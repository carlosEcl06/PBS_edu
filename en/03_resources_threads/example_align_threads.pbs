#!/bin/bash
# Align every simulated sample to the reference with minimap2, sort with
# samtools, and record how long it took with the number of CPUs PBS gave us.
#
# The resource request below is only a default. scaling_experiment.sh
# overrides it from the command line to compare 1, 2, 4, 8 CPUs.
#
#   qsub example_align_threads.pbs

#PBS -N align_threads
#PBS -l select=1:ncpus=2:mem=4gb
#PBS -l walltime=00:20:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1
source ../lib/edu.sh || exit 1
edu_banner
edu_preflight || exit 1
# a failure anywhere in a pipe must fail the pipe, not just its last command
set -o pipefail

THREADS="$(edu_threads)"
OUT="$WORKDIR/03_resources_threads"
RUN="$OUT/run_${PBS_JOBID%%.*}"
REF="$DATA_DIR/ref/genome.fasta"
mkdir -p "$RUN"

START=$(date +%s)
while IFS=$'\t' read -r id r1 r2; do
    echo "[$(date +%T)] aligning $id with $THREADS thread(s)"
    # minimap2 maps (-ax sr = short reads, SAM output); samtools sorts and writes BAM.
    # Both programs run at the same time, connected by a pipe.
    # samtools -@ counts EXTRA threads, hence THREADS - 1.
    edu_exec minimap2 -t "$THREADS" -ax sr "$REF" "$r1" "$r2" 2> "$RUN/$id.minimap2.log" \
        | edu_exec samtools sort -@ "$((THREADS - 1))" -m 256M -T "$RUN/$id.tmp" -o "$RUN/$id.bam" - \
        || { echo "alignment of $id failed" >&2; exit 1; }
done < "$DATA_DIR/samples/samples.tsv"
SECONDS_TAKEN=$(( $(date +%s) - START ))

echo "Aligned all samples in ${SECONDS_TAKEN}s with $THREADS thread(s)"
[ -s "$OUT/timings.tsv" ] || printf 'threads\tseconds\tjob_id\n' > "$OUT/timings.tsv"
printf '%s\t%s\t%s\n' "$THREADS" "$SECONDS_TAKEN" "$PBS_JOBID" >> "$OUT/timings.tsv"

# What PBS has measured about this job so far (works if qstat is available on the node)
qstat -f "$PBS_JOBID" 2>/dev/null | grep -E 'resources_used' || true

# the BAM files are not needed for the timing experiment
rm -rf "$RUN"
