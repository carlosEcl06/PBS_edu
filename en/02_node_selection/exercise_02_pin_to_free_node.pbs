#!/bin/bash
# Exercise 2: before filling in the blank below, run check_free_nodes.sh (or
# `pbsnodes <name>` on a few candidates) to find a node that's actually free
# right now. Don't just guess -- that's the whole point of this exercise.

# Note: on this PBS setup, #PBS directive lines do NOT support trailing
# inline comments -- the whole rest of the line is parsed as directive text.
# Put explanatory comments on their own line, like this one.
#PBS -N exercise_02
#PBS -q workq
# fill in a node name you confirmed is free with check_free_nodes.sh
#PBS -l select=1:ncpus=1:mem=1gb:host=___
#PBS -l walltime=00:02:00
#PBS -o exercise_02.out
#PBS -e exercise_02.err

echo "I requested to run on a specific node."
echo "I actually landed on: $(hostname)"
echo "(these two should match -- if they don't, something's wrong with how you pinned it)"
