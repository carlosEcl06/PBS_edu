#!/bin/bash
# Exercise 3: pick any real bioinformatics tool you might actually need
# (e.g. seqkit, samtools, fastqc -- anything you like) and find its exact
# biocontainers tag. Two ways to find one:
#   1. Search https://nf-core/modules on GitHub for "<toolname>/main.nf" and
#      look at the `container` line.
#   2. Browse https://biocontainers.pro/ or https://quay.io/organization/biocontainers
#      directly.
# Don't use ":latest" -- pick a specific version tag.

#PBS -N exercise_03
#PBS -q workq
#PBS -l select=1:ncpus=2:mem=4gb
#PBS -l walltime=00:15:00
#PBS -o exercise_03.out
#PBS -e exercise_03.err

set -x
mkdir -p exercise_03_work
cd exercise_03_work

TOOL_CONTAINER="docker://quay.io/biocontainers/___:___"   # e.g. seqkit:2.8.2--h9ee0642_0

apptainer pull --force tool.sif "$TOOL_CONTAINER"
apptainer exec tool.sif ___ --version                      # the tool's actual command name

# Bonus, once the above works: copy a small text file into this directory
# and run the tool on it using a RELATIVE path (see the README's bind-mount
# section for why relative, not absolute, is the safe default).
