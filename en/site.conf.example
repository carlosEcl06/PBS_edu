# Reference copy of site.conf. Normally you do NOT edit this file:
# 00_getting_started/setup.sh discovers these values and writes ../site.conf.
# If you prefer to do it by hand:  cp site.conf.example site.conf  and edit.
#
# This file is plain bash, sourced by every script through lib/edu.sh.
# $EDU_ROOT is the en/ directory of this repository.

# Queue to submit to. Leave empty if your cluster has a default queue (most do):
# scripts then never mention a queue. If qsub complains that no queue was
# specified, put its name here; edu_qsub and the Nextflow config will use it.
EDU_QUEUE=""

# Where things live. All three must be on a filesystem that compute nodes can
# see (usually your home, project or scratch area -- NOT /tmp on the login node).
# Together they need about 1 GB with the default settings below.
DATA_DIR="$EDU_ROOT/data"     # downloaded reference + real test reads + simulated samples
WORKDIR="$EDU_ROOT/work"      # results written by your jobs
SIF_CACHE="$EDU_ROOT/sif"     # container images (.sif files)

# "apptainer" or "singularity" (the older name of the same tool).
CONTAINER_RUNTIME="apptainer"

# Extra host directories your jobs need inside containers, comma separated.
# Example: BIND_PATHS="/project/shared,/scratch"
BIND_PATHS=""

# Simulated dataset used from section 03 onwards.
N_SAMPLES=6
READS_PER_SAMPLE=300000       # read pairs per sample; lower it if you are short on space
