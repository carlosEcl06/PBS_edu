#!/bin/bash
# Broken job 6.
# Symptom: the job fails in the first second with a complaint about a variable, yet the
# very same commands work when typed by hand in my shell (where I did: export SAMPLE=sample_03).
#
# Submit from the section directory:  qsub broken_jobs/broken_06.pbs
# Your task: work out why it fails, fix THIS file (edit it in place; git checkout restores the original),
# resubmit from the section directory and check with ./check_07.sh 6

#PBS -N broken_06
#PBS -l select=1:ncpus=1:mem=1gb
#PBS -l walltime=00:05:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1
source ../lib/edu.sh || exit 1
set -u
OUT="$WORKDIR/07_troubleshooting"
mkdir -p "$OUT"

echo "Processing sample: $SAMPLE"
r1="$(awk -F'\t' -v s="$SAMPLE" '$1 == s { print $2 }' "$DATA_DIR/samples/samples.tsv")"
[ -n "$r1" ] || { echo "sample $SAMPLE not found in samples.tsv" >&2; exit 1; }

edu_exec seqkit stats -T "$r1"
echo "sample: $SAMPLE" > "$OUT/broken_06.ok"
