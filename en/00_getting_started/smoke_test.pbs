#!/bin/bash
#PBS -N smoke_test
#PBS -l select=1:ncpus=1:mem=1gb
#PBS -l walltime=00:05:00
#PBS -j oe

# Tiny job used by check_env.sh. It verifies the things a compute node must be
# able to do for the rest of the course: see your files, and run a container.

cd "$PBS_O_WORKDIR" || { echo "SMOKE FAIL: cannot cd to the submit directory"; exit 1; }
source ../lib/edu.sh || { echo "SMOKE FAIL: cannot load lib/edu.sh"; exit 1; }
edu_banner

edu_preflight || { echo "SMOKE FAIL: this node cannot see the data/images or has no container runtime"; exit 1; }
"$CONTAINER_RUNTIME" --version
edu_exec seqkit version || { echo "SMOKE FAIL: could not run a container on this node"; exit 1; }
[ -s "$DATA_DIR/ref/genome.fasta" ] || { echo "SMOKE FAIL: reference not readable from this node"; exit 1; }

echo "SMOKE OK on $(hostname)"
