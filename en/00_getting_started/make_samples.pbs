#!/bin/bash
#PBS -N make_samples
#PBS -l select=1:ncpus=2:mem=2gb
#PBS -l walltime=00:30:00
#PBS -j oe

# Your first bioinformatics job: simulate paired-end Illumina reads for
# N_SAMPLES samples from the SARS-CoV-2 reference, using wgsim (a real read
# simulator from the samtools project) inside a container.
#
# Each sample gets its own random seed, so each carries slightly different
# mutations. The mutations wgsim introduced are saved as a "truth" file.
# Simulated data is used from section 03 on because it can be made as large as
# you need, needs no download, and is identical for everyone.
#
# Submit from this directory:   qsub make_samples.pbs

cd "$PBS_O_WORKDIR" || exit 1
source ../lib/edu.sh || exit 1
edu_banner
edu_preflight || exit 1

REF="$DATA_DIR/ref/genome.fasta"
OUTDIR="$DATA_DIR/samples"
mkdir -p "$OUTDIR"
: > "$OUTDIR/samples.tsv"

for i in $(seq 1 "$N_SAMPLES"); do
    id="$(printf 'sample_%02d' "$i")"
    r1="$OUTDIR/${id}_R1.fastq"
    r2="$OUTDIR/${id}_R2.fastq"
    echo "[$(date +%T)] simulating $id ($READS_PER_SAMPLE read pairs)"
    # wgsim prints the mutations it introduced on stdout
    edu_exec wgsim -N "$READS_PER_SAMPLE" -1 150 -2 150 -r 0.002 -e 0.005 -S "$((1000 + i))" \
        "$REF" "$r1" "$r2" > "$OUTDIR/${id}.truth_mutations.txt" || exit 1
    gzip -f "$r1" "$r2"
    printf '%s\t%s\t%s\n' "$id" "$r1.gz" "$r2.gz" >> "$OUTDIR/samples.tsv"
done

echo "[$(date +%T)] done. Sample sheet:"
cat "$OUTDIR/samples.tsv"
du -sh "$OUTDIR"
