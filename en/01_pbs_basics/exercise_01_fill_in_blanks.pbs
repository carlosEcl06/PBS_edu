#!/bin/bash
# Exercise 1: fill in the blanks (marked ___) to make this a valid, working PBS
# job, then submit it with `qsub exercise_01_fill_in_blanks.pbs`.
#
# Goal: a job that requests 2 CPUs and 2GB of RAM, runs for at most 2 minutes,
# prints which node it landed on, counts to 5 with a 1-second pause between each
# number, and writes its output to files named after the job itself.

# Note: on this PBS setup, #PBS directive lines do NOT support trailing
# inline comments -- the whole rest of the line is parsed as directive text.
# That's why the hints below are on their own separate comment lines.

# give it a short, descriptive name
#PBS -N ___
#PBS -q workq
# 2 CPUs, 2GB RAM
#PBS -l select=1:ncpus=___:mem=___gb
# 2 minutes
#PBS -l walltime=00:0___:00
# match your job name above
#PBS -o ___.out
#PBS -e ___.err

echo "Running on $(___)"                      # hint: same command used in the example

for i in $(seq 1 5); do
    echo "count: $i"
    sleep ___                                 # 1 second
done

echo "All done."

# Once it's submitted:
#   qstat -u $(whoami)          -- watch it move from Q to R
#   cat <your .out file>        -- once it's finished
#
# Check your work against exercise_01_ANSWER.pbs if anything doesn't submit
# cleanly (qsub will complain loudly and immediately if a #PBS line is malformed).
