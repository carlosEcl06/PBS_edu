#!/bin/bash
# The smallest useful job. Submit it from this directory:  qsub example_hello_world.pbs

# name shown by qstat
#PBS -N hello
# one chunk with 1 CPU and 1 GB of memory
#PBS -l select=1:ncpus=1:mem=1gb
# give up after 2 minutes
#PBS -l walltime=00:02:00
# put error messages in the same log file as normal output
#PBS -j oe

# A job does NOT start where you ran qsub. It starts in your home directory:
echo "Directory when the job started: $(pwd)"
cd "$PBS_O_WORKDIR" || exit 1
echo "Directory after cd:             $(pwd)"

echo "Hello from the compute node:    $(hostname)"
echo "Job id:                         $PBS_JOBID"
echo "CPUs PBS gave this job:         ${NCPUS:-unknown}"
echo "Date:                           $(date)"

# Careful: this shows the memory of the WHOLE node, not the 1 GB you asked for.
free -h

sleep 5
echo "Done."
