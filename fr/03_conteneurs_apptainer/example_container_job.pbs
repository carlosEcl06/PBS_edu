#!/bin/bash
#PBS -N example_container
#PBS -q workq
#PBS -l select=1:ncpus=1:mem=1gb
#PBS -l walltime=00:10:00
#PBS -o example_container.out
#PBS -e example_container.err

set -x
mkdir -p apptainer_edu_work
cd apptainer_edu_work

echo "Téléchargement d'un petit conteneur public rapide (Ubuntu 22.04)..."
apptainer pull --force ubuntu.sif docker://ubuntu:22.04

echo "À l'intérieur du conteneur, /etc/os-release indique :"
apptainer exec ubuntu.sif cat /etc/os-release

echo ""
echo "En dehors du conteneur, sur le vrai nœud de calcul, /etc/os-release indique :"
cat /etc/os-release

echo ""
echo "Des chaînes de système d'exploitation différentes ci-dessus confirment que"
echo "le système de fichiers du conteneur est bien son propre environnement, pas"
echo "juste les outils de l'hôte réétiquetés. (Remarque : contrairement à Docker,"
echo "Apptainer partage le hostname/réseau de l'hôte par défaut -- exécuter"
echo "'hostname' dedans vs dehors montrerait la MÊME valeur, ce qui est attendu"
echo "ici, pas un signe de problème.)"
