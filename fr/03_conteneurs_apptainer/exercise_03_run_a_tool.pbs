#!/bin/bash
# Exercice 3 : choisissez un véritable outil de bioinformatique dont vous
# pourriez avoir besoin (ex. seqkit, samtools, fastqc -- ce que vous voulez)
# et trouvez son tag biocontainers exact. Deux façons d'en trouver un :
#   1. Cherchez sur https://github.com/nf-core/modules "<nomoutil>/main.nf"
#      et regardez la ligne `container`.
#   2. Naviguez directement sur https://biocontainers.pro/ ou
#      https://quay.io/organization/biocontainers
# N'utilisez pas ":latest" -- choisissez un tag de version spécifique.

#PBS -N exercise_03
#PBS -q workq
#PBS -l select=1:ncpus=2:mem=4gb
#PBS -l walltime=00:15:00
#PBS -o exercise_03.out
#PBS -e exercise_03.err

set -x
mkdir -p exercise_03_work
cd exercise_03_work

TOOL_CONTAINER="docker://quay.io/biocontainers/___:___"   # ex. seqkit:2.8.2--h9ee0642_0

apptainer pull --force tool.sif "$TOOL_CONTAINER"
apptainer exec tool.sif ___ --version                      # le vrai nom de commande de l'outil

# Bonus, une fois que ce qui précède fonctionne : copiez un petit fichier
# texte dans ce répertoire et exécutez l'outil dessus en utilisant un
# chemin RELATIF (voir la section sur les bind mounts dans le README pour
# comprendre pourquoi relatif, et non absolu, est le choix sûr par défaut).
