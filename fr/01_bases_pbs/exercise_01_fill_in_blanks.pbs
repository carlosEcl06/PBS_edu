#!/bin/bash
# Exercice 1 : remplissez les blancs (marqués ___) pour faire de ceci un job
# PBS valide et fonctionnel, puis soumettez-le avec
# `qsub exercise_01_fill_in_blanks.pbs`.
#
# Objectif : un job qui demande 2 CPU et 2 Go de RAM, s'exécute au maximum
# 2 minutes, affiche sur quel nœud il est tombé, compte jusqu'à 5 avec une
# pause d'1 seconde entre chaque nombre, et écrit sa sortie dans des fichiers
# nommés d'après le job lui-même.

# Remarque : sur cette configuration PBS, les lignes de directive #PBS ne
# supportent PAS les commentaires en fin de ligne -- tout le reste de la
# ligne est interprété comme du texte de directive. C'est pourquoi les
# indices ci-dessous sont sur des lignes de commentaire séparées.

# donnez-lui un nom court et descriptif
#PBS -N ___
#PBS -q workq
# 2 CPU, 2 Go de RAM
#PBS -l select=1:ncpus=___:mem=___gb
# 2 minutes
#PBS -l walltime=00:0___:00
# à faire correspondre avec le nom du job ci-dessus
#PBS -o ___.out
#PBS -e ___.err

echo "Exécuté sur $(___)"                      # indice : même commande utilisée dans l'exemple

for i in $(seq 1 5); do
    echo "compte : $i"
    sleep ___                                 # 1 seconde
done

echo "Terminé."

# Une fois soumis :
#   qstat -u $(whoami)          -- observez-le passer de Q à R
#   cat <votre fichier .out>    -- une fois terminé
#
# Vérifiez votre travail avec exercise_01_ANSWER.pbs si quelque chose ne se
# soumet pas correctement (qsub se plaint bruyamment et immédiatement si une
# ligne #PBS est mal formée).
