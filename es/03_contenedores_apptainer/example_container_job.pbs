#!/bin/bash
#PBS -N example_container
#PBS -q workq
#PBS -l select=1:ncpus=1:mem=1gb
#PBS -l walltime=00:10:00
#PBS -o example_container.out
#PBS -e example_container.err

set -x
mkdir -p apptainer_edu_work
cd apptainer_edu_work

echo "Descargando un contenedor público pequeño y rápido (Ubuntu 22.04)..."
apptainer pull --force ubuntu.sif docker://ubuntu:22.04

echo "Dentro del contenedor, /etc/os-release dice:"
apptainer exec ubuntu.sif cat /etc/os-release

echo ""
echo "Fuera del contenedor, en el nodo de cómputo real, /etc/os-release dice:"
cat /etc/os-release

echo ""
echo "Cadenas de sistema operativo distintas arriba confirman que el sistema"
echo "de archivos del contenedor es realmente su propio entorno, no solo las"
echo "herramientas del host reetiquetadas. (Nota: a diferencia de Docker,"
echo "Apptainer comparte el hostname/red del host por defecto -- ejecutar"
echo "'hostname' dentro vs fuera mostraría el MISMO valor, lo cual es"
echo "esperado aquí, no señal de error.)"
