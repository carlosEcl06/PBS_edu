#!/bin/bash
#PBS -N make_samples
#PBS -l select=1:ncpus=2:mem=2gb
#PBS -l walltime=00:30:00
#PBS -j oe

# Tu primer job de bioinformática: simula lecturas Illumina paired-end para
# N_SAMPLES muestras a partir de la referencia de SARS-CoV-2, usando wgsim (un
# simulador de lecturas real, del proyecto samtools) dentro de un contenedor.
#
# Cada muestra recibe su propia semilla aleatoria, así que cada una lleva
# mutaciones un poco distintas. Las mutaciones que introdujo wgsim se guardan en
# un archivo "truth". Los datos simulados se usan a partir de la sección 03 porque
# pueden ser tan grandes como haga falta, no requieren descarga y son iguales para todos.
#
# Envíalo desde este directorio:   qsub make_samples.pbs

cd "$PBS_O_WORKDIR" || exit 1
source ../lib/edu.sh || exit 1
edu_banner
edu_preflight || exit 1

REF="$DATA_DIR/ref/genome.fasta"
OUTDIR="$DATA_DIR/samples"
mkdir -p "$OUTDIR"
: > "$OUTDIR/samples.tsv"

for i in $(seq 1 "$N_SAMPLES"); do
    id="$(printf 'sample_%02d' "$i")"
    r1="$OUTDIR/${id}_R1.fastq"
    r2="$OUTDIR/${id}_R2.fastq"
    echo "[$(date +%T)] simulando $id ($READS_PER_SAMPLE pares de lecturas)"
    # wgsim imprime en la salida estándar las mutaciones que introdujo
    edu_exec wgsim -N "$READS_PER_SAMPLE" -1 150 -2 150 -r 0.002 -e 0.005 -S "$((1000 + i))" \
        "$REF" "$r1" "$r2" > "$OUTDIR/${id}.truth_mutations.txt" || exit 1
    gzip -f "$r1" "$r2"
    printf '%s\t%s\t%s\n' "$id" "$r1.gz" "$r2.gz" >> "$OUTDIR/samples.tsv"
done

echo "[$(date +%T)] listo. Hoja de muestras:"
cat "$OUTDIR/samples.tsv"
du -sh "$OUTDIR"
