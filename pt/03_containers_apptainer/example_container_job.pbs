#!/bin/bash
#PBS -N example_container
#PBS -q workq
#PBS -l select=1:ncpus=1:mem=1gb
#PBS -l walltime=00:10:00
#PBS -o example_container.out
#PBS -e example_container.err

set -x
mkdir -p apptainer_edu_work
cd apptainer_edu_work

echo "Baixando um container público pequeno e rápido (Ubuntu 22.04)..."
apptainer pull --force ubuntu.sif docker://ubuntu:22.04

echo "Dentro do container, /etc/os-release diz:"
apptainer exec ubuntu.sif cat /etc/os-release

echo ""
echo "Fora do container, no nó de computação real, /etc/os-release diz:"
cat /etc/os-release

echo ""
echo "Strings de SO diferentes acima confirmam que o sistema de arquivos do"
echo "container é realmente seu próprio ambiente, não apenas as ferramentas do"
echo "host reetiquetadas. (Nota: diferente do Docker, o Apptainer compartilha o"
echo "hostname/rede do host por padrão -- rodar 'hostname' dentro vs fora"
echo "mostraria o MESMO valor, o que é esperado aqui, não sinal de erro.)"
