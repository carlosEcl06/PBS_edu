#!/bin/bash
# Exercício 3: escolha qualquer ferramenta real de bioinformática que você
# possa realmente precisar (ex.: seqkit, samtools, fastqc -- o que preferir)
# e encontre sua tag exata no biocontainers. Duas formas de achar uma:
#   1. Procure em https://github.com/nf-core/modules por "<ferramenta>/main.nf"
#      e veja a linha `container`.
#   2. Navegue direto em https://biocontainers.pro/ ou
#      https://quay.io/organization/biocontainers
# Não use ":latest" -- escolha uma tag de versão específica.

#PBS -N exercise_03
#PBS -q workq
#PBS -l select=1:ncpus=2:mem=4gb
#PBS -l walltime=00:15:00
#PBS -o exercise_03.out
#PBS -e exercise_03.err

set -x
mkdir -p exercise_03_work
cd exercise_03_work

TOOL_CONTAINER="docker://quay.io/biocontainers/___:___"   # ex.: seqkit:2.8.2--h9ee0642_0

apptainer pull --force tool.sif "$TOOL_CONTAINER"
apptainer exec tool.sif ___ --version                      # o nome real do comando da ferramenta

# Bônus, depois que o acima funcionar: copie um arquivo de texto pequeno para
# este diretório e rode a ferramenta nele usando um caminho RELATIVO (veja a
# seção sobre bind-mounts no README para entender por que relativo, e não
# absoluto, é o padrão seguro).
