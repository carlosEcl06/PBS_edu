#!/bin/bash
#PBS -N hello_world
#PBS -q workq
#PBS -l select=1:ncpus=1:mem=1gb
#PBS -l walltime=00:05:00
#PBS -o example_hello_world.out
#PBS -e example_hello_world.err

echo "Olá de $(hostname), rodando como job $PBS_JOBID"
echo "Iniciado em: $(date)"
echo "Eu tenho ${PBS_NUM_PPN:-1} CPU(s) e esta quantidade de memória disponível:"
free -h | head -2
sleep 5
echo "Terminado em: $(date)"
