#!/bin/bash
# Um primeiro job de bioinformática "de verdade": conta reads e bases nos dois
# arquivos FASTQ reais, usando só ferramentas Unix padrão (zcat, wc, awk).
#
#   qsub example_count_reads.pbs
#   cat count_reads.o<jobid>            (depois que terminar)
#   cat results/fastq_counts.tsv        (results/ é um atalho para sua pasta de saída)

#PBS -N count_reads
#PBS -l select=1:ncpus=1:mem=1gb
#PBS -l walltime=00:05:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1
source ../lib/edu.sh || exit 1
edu_banner

OUT="$WORKDIR/01_pbs_basics"
mkdir -p "$OUT"
printf 'file\treads\tbases\n' > "$OUT/fastq_counts.tsv"

for f in "$DATA_DIR"/real/test_1.fastq.gz "$DATA_DIR"/real/test_2.fastq.gz; do
    # FASTQ tem 4 linhas por read; a linha 2 de cada registro é a sequência.
    zcat "$f" | awk -v name="$(basename "$f")" \
        'NR % 4 == 2 { reads++; bases += length($0) } END { printf "%s\t%d\t%d\n", name, reads, bases }' \
        >> "$OUT/fastq_counts.tsv"
done

cat "$OUT/fastq_counts.tsv"
echo "Tabela salva em: $OUT/fastq_counts.tsv  (a partir do diretório da seção: results/fastq_counts.tsv)"
