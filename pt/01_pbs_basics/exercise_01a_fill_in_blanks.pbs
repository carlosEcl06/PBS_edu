#!/bin/bash
# Exercício 1a -- preencha as lacunas (___) para tornar este job válido e funcional.
#
# Objetivo: contar os reads e as bases de test_1.fastq.gz.
#   * o job precisa de 1 CPU, 1 GB de memória e no máximo 5 minutos
#   * o stderr deve ser juntado ao stdout (um só arquivo de log)
#   * um registro FASTQ tem 4 linhas; a sequência é a linha 2 de cada registro
#
# Depois:  qsub exercise_01a_fill_in_blanks.pbs
#          ./check_01a.sh
#
# Se uma linha #PBS estiver malformada, o qsub recusa o script na hora. Ele diz o
# campo errado, não a linha: "Illegal attribute or resource value select.ncpus"
# significa o valor de ncpus= dentro de select=. Ele aponta um campo por vez, então
# você pode ver várias mensagens seguidas. Isso é normal: leia, corrija, submeta de novo.
# Lembre-se: comentários de linhas #PBS ficam numa linha própria, como aqui.

# um nome curto, letras/dígitos/sublinhado, começando com letra (ex.: count_fq)
#PBS -N ___
# preencha o número de CPUs e os gigabytes de memória
#PBS -l select=1:ncpus=___:mem=___gb
# cinco minutos = 00:05:00 (preencha o único dígito que falta)
#PBS -l walltime=00:0___:00
# as letras da opção que juntam stdout e stderr são "oe"
#PBS -j ___

cd "$PBS_O_WORKDIR" || exit 1
source ../lib/edu.sh || exit 1
edu_banner

FASTQ="$DATA_DIR/real/test_1.fastq.gz"
OUT="$WORKDIR/01_pbs_basics"
mkdir -p "$OUT"

# número total de linhas, dividido pelas linhas por registro
lines=$(zcat "$FASTQ" | wc -l)
reads=$(( lines / ___ ))

# soma o comprimento de cada linha de sequência (length($0) do awk dá o comprimento de uma linha)
bases=$(zcat "$FASTQ" | awk 'NR % 4 == 2 { n += ___($0) } END { print n }')

echo "reads: $reads"
echo "bases: $bases"
echo "$reads" > "$OUT/read_count.txt"
echo "$bases" > "$OUT/base_count.txt"
