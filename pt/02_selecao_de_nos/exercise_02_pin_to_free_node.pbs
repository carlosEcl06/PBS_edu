#!/bin/bash
# Exercício 2: antes de preencher a lacuna abaixo, rode check_free_nodes.sh
# (ou `pbsnodes <nome>` em alguns candidatos) para achar um nó que esteja
# realmente livre agora. Não chute -- esse é o objetivo do exercício.

# Nota: nesta configuração de PBS, linhas de diretiva #PBS NÃO suportam
# comentários no final da linha -- o resto da linha inteira é interpretado
# como texto da diretiva. Coloque comentários explicativos em uma linha
# própria, como esta.
#PBS -N exercise_02
#PBS -q workq
# preencha um nome de nó que você confirmou estar livre com check_free_nodes.sh
#PBS -l select=1:ncpus=1:mem=1gb:host=___
#PBS -l walltime=00:02:00
#PBS -o exercise_02.out
#PBS -e exercise_02.err

echo "Eu pedi para rodar num nó específico."
echo "Eu realmente caí em: $(hostname)"
echo "(esses dois devem bater -- se não baterem, algo deu errado na forma como você fixou o nó)"
